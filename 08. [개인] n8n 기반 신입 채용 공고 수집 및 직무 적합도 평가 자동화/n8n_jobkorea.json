              "id": "413b24c0-4a19-4a66-b288-aa0f7f183f37",
              "name": "recruitment_metadata",
              "value": "={{ [\n  '[모집요강]',\n  ...$json.recruitment_keys\n    .map((key, i) => $json.recruitment_values[i]?.trim()\n      ? `${key}: ${$json.recruitment_values[i].trim()}`\n      : null\n    )\n    .filter(Boolean),\n\n  '',\n  '[지원자격]',\n  ...$json.qualification_keys\n    .map((key, i) => $json.qualification_values[i]?.trim()\n      ? `${key}: ${$json.qualification_values[i].trim()}`\n      : null\n    )\n    .filter(Boolean),\n\n  '',\n  '[우대조건]',\n  ...$json.preference_keys\n    .map((key, i) => $json.preference_values[i]?.trim()\n      ? `${key}: ${$json.preference_values[i].trim()}`\n      : null\n    )\n    .filter(Boolean),\n].join('\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
