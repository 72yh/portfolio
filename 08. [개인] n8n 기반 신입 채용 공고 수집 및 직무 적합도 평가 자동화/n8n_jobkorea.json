      "id": "a4672e23-1e92-4336-a14f-c79f39aba690",
      "name": "Aggregate Job Post URLs and Summaries"
    },
    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>1000대 기업 신규 신입 채용 공고</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f3f4f6; font-family:Arial, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; color:#1f2937;\">\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n  <tr>\n    <td align=\"center\" style=\"padding:32px 16px;\">\n\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n        style=\"max-width:680px; background-color:#ffffff; border-radius:16px; overflow:hidden;\">\n\n        <!-- 헤더 -->\n        <tr>\n          <td style=\"padding:32px; background-color:#111827;\">\n            <div style=\"margin-bottom:8px; font-size:12px; line-height:18px; font-weight:700; letter-spacing:1.2px; color:#93c5fd;\">\n              DAILY JOB DIGEST\n            </div>\n\n            <div style=\"font-size:26px; line-height:36px; font-weight:700; color:#ffffff;\">\n              1000대 기업 신규 신입 채용 공고\n            </div>\n\n            <div style=\"margin-top:10px; font-size:14px; line-height:22px; color:#d1d5db;\">\n              포트폴리오와의 연관성을 기준으로\n              {{\n                ($json.summary ?? []).filter(\n                  job => typeof job.summary === 'string' && job.summary.trim()\n                ).length\n              }}건을 선별했습니다.\n            </div>\n          </td>\n        </tr>\n\n        <!-- 공고 목록 -->\n        <tr>\n          <td style=\"padding:24px;\">\n\n            {{\n              (() => {\n                const jobs = ($json.summary ?? []).filter(\n                  job =>\n                    typeof job.summary === 'string' &&\n                    job.summary.trim() !== ''\n                );\n\n                const escapeHtml = value =>\n                  String(value ?? '')\n                    .replace(/&/g, '&amp;')\n                    .replace(/</g, '&lt;')\n                    .replace(/>/g, '&gt;')\n                    .replace(/\"/g, '&quot;')\n                    .replace(/'/g, '&#39;');\n\n                return jobs.map((job, index) => {\n                  const summary = escapeHtml(job.summary)\n                    .replace(/\\r?\\n/g, '<br>');\n\n                  const rawUrl = String(job.job_url ?? '').trim();\n\n                  const jobUrl = /^https?:\\/\\/[^\\s\"]+$/i.test(rawUrl)\n                    ? escapeHtml(rawUrl)\n                    : '';\n\n                  return `\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                      style=\"margin-bottom:18px; border:1px solid #e5e7eb; border-radius:12px; border-collapse:separate;\">\n\n                      <tr>\n                        <td style=\"padding:20px 22px 10px;\">\n                          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                            <tr>\n                              <td style=\"font-size:13px; line-height:20px; font-weight:700; color:#2563eb;\">\n                                추천 공고 ${index + 1}\n                              </td>\n\n                              <td align=\"right\" style=\"font-size:12px; line-height:18px; color:#9ca3af;\">\n                                JOBKOREA\n                              </td>\n                            </tr>\n                          </table>\n                        </td>\n                      </tr>\n\n                      <tr>\n                        <td style=\"padding:4px 22px 20px; font-size:15px; line-height:26px; color:#374151; word-break:keep-all;\">\n                          ${summary}\n                        </td>\n                      </tr>\n\n                      ${\n                        jobUrl\n                          ? `\n                            <tr>\n                              <td style=\"padding:0 22px 22px;\">\n                                <a href=\"${jobUrl}\"\n                                  target=\"_blank\"\n                                  style=\"display:inline-block; padding:11px 18px; background-color:#2563eb; color:#ffffff; text-decoration:none; font-size:14px; line-height:20px; font-weight:700; border-radius:8px;\">\n                                  공고 상세보기 →\n                                </a>\n                              </td>\n                            </tr>\n                          `\n                          : ''\n                      }\n\n                    </table>\n                  `;\n                }).join('');\n              })()\n            }}\n\n          </td>\n        </tr>\n\n        <!-- 안내 -->\n        <tr>\n          <td style=\"padding:0 24px 28px;\">\n            <div style=\"padding:16px 18px; background-color:#f9fafb; border-radius:10px; font-size:12px; line-height:20px; color:#6b7280;\">\n              AI가 채용 공고와 포트폴리오의 연관성을 분석한 결과입니다.\n              지원 전 원문에서 자격요건, 근무조건과 마감일을 다시 확인하세요.\n            </div>\n          </td>\n        </tr>\n\n        <!-- 푸터 -->\n        <tr>\n          <td style=\"padding:20px 24px; border-top:1px solid #f3f4f6; text-align:center; font-size:11px; line-height:18px; color:#9ca3af;\">\n            이 메일은 n8n 워크플로우를 통해 자동 생성되었습니다.\n          </td>\n        </tr>\n\n      </table>\n\n    </td>\n  </tr>\n</table>\n\n</body>\n</html>"
      },
