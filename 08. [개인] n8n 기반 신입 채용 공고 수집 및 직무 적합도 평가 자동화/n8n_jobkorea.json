            {
              "id": "b1c2d3e4-2222-4a5b-9c6d-bb1122334455",
              "name": "job_markdown",
              "value": "={{ `# ${$('Clean Metadata').item.json.title ?? ''}\\n\\n- 회사: ${$('Clean Metadata').item.json.organization ?? ''}\\n- 고용형태: ${$('Clean Metadata').item.json.employment_type ?? ''}\\n- 경력: ${$('Clean Metadata').item.json.experience ?? ''}\\n- 학력: ${$('Clean Metadata').item.json.education ?? ''}\\n- 마감: ${$('Clean Metadata').item.json.valid_through ?? ''}\\n\\n## 모집요강 · 지원자격 · 우대조건\\n\\n${$('Clean Metadata').item.json.recruitment_metadata ?? ''}\\n\\n---\\n\\n${$json.job_details ?? ''}\\n\\n---\\n\\n${$json.job_img ?? ''}` }}",
